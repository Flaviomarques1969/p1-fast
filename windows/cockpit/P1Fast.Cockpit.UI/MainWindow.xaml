<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="P1Fast.Cockpit.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="P1 Fast — Cockpit Piloto">

    <!-- Fundo preto fora do device (como o body do mockup canônico) -->
    <Grid Background="#0a0a0a">

        <!--
            Wrapper externo: Viewbox escala o device (956×440 do mockup) pro
            tamanho disponível mantendo proporções (mockup canônico congelado
            byte-for-byte). Na tela 10,5" 1920×1280 vai dar ~1912×880 com
            letterbox vertical preto.
        -->
        <Viewbox HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 StretchDirection="Both">

            <!-- Device — 956×440 conforme mockup canônico (.device) -->
            <Border x:Name="DeviceRoot"
                    Width="956" Height="440"
                    Background="#171717"
                    CornerRadius="48"
                    BorderThickness="1"
                    BorderBrush="#262626">
                <Grid>

                    <!--
                        Halo — primeira iteração usa um SolidColorBrush
                        nomeado (HaloBrush) por simplicidade. Próxima
                        iteração troca por RadialGradientBrush quando eu
                        confirmar a sintaxe correta no WinUI 3 1.6 atual.
                        No mockup é o ::before do .device com radial-gradient
                        OKlch.
                    -->
                    <Rectangle IsHitTestVisible="False"
                               Opacity="0.5">
                        <Rectangle.Fill>
                            <SolidColorBrush x:Name="HaloBrush" Color="Transparent"/>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Status text (placeholder; substituído pelos próximos elementos) -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="P1 FAST"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7"/>
                        <TextBlock x:Name="StatusText"
                                   Text="—"
                                   Foreground="#a0a0a0"
                                   FontSize="20"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</Window>
