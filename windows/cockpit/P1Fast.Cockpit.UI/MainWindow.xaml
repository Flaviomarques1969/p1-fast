<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="P1Fast.Cockpit.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="P1 Fast — Cockpit Piloto">

    <Grid Background="#0a0a0a">
        <Viewbox HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 StretchDirection="Both">

            <!-- Device 956×440 do mockup canônico -->
            <Border Width="956" Height="440"
                    Background="#171717"
                    CornerRadius="48"
                    BorderThickness="1"
                    BorderBrush="#262626">
                <Grid>

                    <!--
                        Halo radial gradiente — espelha o web/cockpit.css:
                        radial-gradient(ellipse 65% 75% at 50% 55%, cor 0%, transparent 65%).
                        Estados RecordeStint/MelhorHistorico pulsam via Storyboard
                        em ApplyHalo (PiorStint fica fixo, alerta sem fadiga visual).
                    -->
                    <Rectangle x:Name="HaloRect" IsHitTestVisible="False" Opacity="1.0">
                        <Rectangle.Fill>
                            <RadialGradientBrush x:Name="HaloBrush"
                                                 Center="0.5,0.55"
                                                 GradientOrigin="0.5,0.55"
                                                 RadiusX="0.65"
                                                 RadiusY="0.75">
                                <GradientStop x:Name="HaloStopCenter" Offset="0.0" Color="Transparent"/>
                                <GradientStop x:Name="HaloStopEdge"   Offset="0.65" Color="Transparent"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!--
                        Notch — decoração à esquerda do device (mockup .notch:
                        position:absolute left:18 top:50% width:36 height:128).
                        Visualmente é um retângulo preto arredondado.
                    -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0"
                            Width="36"
                            Height="128"
                            CornerRadius="20"
                            Background="Black"
                            BorderBrush="#0E0E0E"
                            BorderThickness="1"/>

                    <!--
                        Telemetria chip — coluna de 3 dots à direita (mockup
                        .telemetria-chip: position:absolute right:10 top:50%).
                        Cores: faint default; ok=verde; warn=amarelo.
                    -->
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                Spacing="6">
                        <Ellipse x:Name="TelemetriaDot01" Width="6" Height="6" Fill="#4FE060"/>
                        <Ellipse x:Name="TelemetriaDot02" Width="6" Height="6" Fill="#4FE060"/>
                        <Ellipse x:Name="TelemetriaDot03" Width="6" Height="6" Fill="#606060"/>
                    </StackPanel>

                    <!--
                        Shift light — 12 LEDs no topo. Container Border arredondado
                        com Padding 26,9 e Spacing 18 (mesmas dimensões do mockup
                        .shift-light).
                    -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,10,0,0"
                            Padding="22,9"
                            CornerRadius="999"
                            Background="#0F0F0F"
                            BorderBrush="#1F1F1F"
                            BorderThickness="1">
                        <!-- 17 LEDs em pirâmide simétrica (tier 1..9..1), igual ao
                             painel aprovado 22/06. Pontas (tier 1) verdes acendem
                             primeiro; centro (tier 9) vermelho é reservado pro FIRE.
                             Enchem das PONTAS pro CENTRO conforme sobe rumo à potência. -->
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <Ellipse x:Name="Led01" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led02" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led03" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led04" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led05" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led06" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led07" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led08" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led09" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led10" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led11" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led12" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led13" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led14" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led15" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led16" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led17" Width="13" Height="13" Fill="#1A1A1A"/>
                        </StackPanel>
                    </Border>

                    <!--
                        Apex header — 4 pontos (entrada, freio, ápice, saída) em
                        linha. No mockup é position:absolute top:46 left:60 right:36
                        com display:flex justify-content:space-between. Em XAML:
                        Grid com 4 colunas iguais, ancorado ao topo com Margin.
                    -->
                    <Grid Margin="60,46,36,0"
                          VerticalAlignment="Top"
                          Height="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Entrada -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Spacing="14"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="ENTRADA"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="ApexEntradaValor"
                                       Text="—"
                                       FontSize="32"
                                       FontWeight="ExtraBold"
                                       Foreground="#A0A0A0"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <!-- Freio -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="14"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="FREIO"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="ApexFreioValor"
                                       Text="—"
                                       FontSize="32"
                                       FontWeight="ExtraBold"
                                       Foreground="#A0A0A0"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <!-- Ápice -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="14"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="ÁPICE"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="ApexApiceValor"
                                       Text="—"
                                       FontSize="32"
                                       FontWeight="ExtraBold"
                                       Foreground="#A0A0A0"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <!-- Saída -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="14"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="SAÍDA"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="ApexSaidaValor"
                                       Text="—"
                                       FontSize="32"
                                       FontWeight="ExtraBold"
                                       Foreground="#A0A0A0"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </Grid>

                    <!--
                        Info bloco — delta gigante no centro + ação abaixo.
                        Mockup: position:absolute left/top 50% translate(-50%, -50%).
                        Em XAML: StackPanel centralizado com VerticalAlignment Center.
                    -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14">
                        <TextBlock x:Name="DeltaText"
                                   Text="0.00"
                                   FontSize="180"
                                   FontWeight="ExtraBold"
                                   Foreground="#A0A0A0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AcaoText"
                                   Text=""
                                   FontSize="32"
                                   FontWeight="ExtraBold"
                                   Foreground="#F0C040"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!--
                        Alert bloco — mensagem que vem do fundo (z-axis simulado
                        via ScaleTransform). Posicionada à direita (left:100%-240).
                        No mockup tem blur 12px → 0 + scale 0.35 → 1 + opacity 0 → 1
                        em transition 1200 ms ease-msg. Por enquanto sem animação;
                        Visibility liga/desliga.
                    -->
                    <Border x:Name="AlertBlocoRoot"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,40,0"
                            MaxWidth="380"
                            RenderTransformOrigin="0.5,0.5"
                            Visibility="Collapsed">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="AlertScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Border.RenderTransform>
                        <TextBlock x:Name="AlertText"
                                   Text=""
                                   FontSize="34"
                                   FontWeight="ExtraBold"
                                   Foreground="#82C8FF"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!--
                        Stint bar — 12 blocos ao longo do bottom mostrando
                        o histórico de trechos do stint atual.
                        Mockup: position:absolute left:60 right:8 bottom:4 height:14.
                        Estados: neutral, faster, slower, best-stint (shimmer),
                        best-alltime (bloom dourado), current (foco amarelo).
                    -->
                    <Grid Margin="60,0,8,4"
                          VerticalAlignment="Bottom"
                          Height="14">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Border x:Name="StintBlock01" Width="60" Height="14" CornerRadius="2" Background="#606060"/>
                            <Border x:Name="StintBlock02" Width="60" Height="14" CornerRadius="2" Background="#606060"/>
                            <Border x:Name="StintBlock03" Width="60" Height="14" CornerRadius="2" Background="#606060"/>
                            <Border x:Name="StintBlock04" Width="60" Height="14" CornerRadius="2" Background="#606060"/>
                            <Border x:Name="StintBlock05" Width="60" Height="14" CornerRadius="2" Background="#606060"/>
                            <Border x:Name="StintBlock06" Width="60" Height="14" CornerRadius="2" Background="#606060"/>
                            <Border x:Name="StintBlock07" Width="60" Height="14" CornerRadius="2" Background="#606060"/>
                            <Border x:Name="StintBlock08" Width="60" Height="14" CornerRadius="2" Background="#606060"/>
                            <Border x:Name="StintBlock09" Width="60" Height="14" CornerRadius="2" Background="#606060"/>
                            <Border x:Name="StintBlock10" Width="60" Height="14" CornerRadius="2" Background="#606060"/>
                            <Border x:Name="StintBlock11" Width="60" Height="14" CornerRadius="2" Background="#606060"/>
                            <Border x:Name="StintBlock12" Width="60" Height="14" CornerRadius="2" Background="#606060"/>
                        </StackPanel>
                    </Grid>

                    <!-- Status text (debug, no rodapé) -->
                    <TextBlock x:Name="StatusText"
                               Text="—"
                               Foreground="#606060"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,24"/>

                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</Window>
