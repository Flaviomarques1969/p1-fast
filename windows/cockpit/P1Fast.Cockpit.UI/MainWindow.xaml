<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="P1Fast.Cockpit.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="P1 Fast — Cockpit Piloto">

    <Grid Background="#0a0a0a">
        <Viewbox HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 StretchDirection="Both">

            <!-- Device 956×440 do mockup canônico -->
            <Border Width="956" Height="440"
                    Background="#171717"
                    CornerRadius="48"
                    BorderThickness="1"
                    BorderBrush="#262626">
                <Grid>

                    <!-- Halo (placeholder SolidColorBrush; radial fica pra próxima) -->
                    <Rectangle IsHitTestVisible="False" Opacity="0.5">
                        <Rectangle.Fill>
                            <SolidColorBrush x:Name="HaloBrush" Color="Transparent"/>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!--
                        Shift light — 12 LEDs no topo. Container Border arredondado
                        com Padding 26,9 e Spacing 18 (mesmas dimensões do mockup
                        .shift-light).
                    -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,10,0,0"
                            Padding="26,9"
                            CornerRadius="999"
                            Background="#0F0F0F"
                            BorderBrush="#1F1F1F"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <Ellipse x:Name="Led01" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led02" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led03" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led04" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led05" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led06" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led07" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led08" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led09" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led10" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led11" Width="13" Height="13" Fill="#1A1A1A"/>
                            <Ellipse x:Name="Led12" Width="13" Height="13" Fill="#1A1A1A"/>
                        </StackPanel>
                    </Border>

                    <!--
                        Apex header — 4 pontos (entrada, freio, ápice, saída) em
                        linha. No mockup é position:absolute top:46 left:60 right:36
                        com display:flex justify-content:space-between. Em XAML:
                        Grid com 4 colunas iguais, ancorado ao topo com Margin.
                    -->
                    <Grid Margin="60,46,36,0"
                          VerticalAlignment="Top"
                          Height="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Entrada -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Spacing="14"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="ENTRADA"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="ApexEntradaValor"
                                       Text="—"
                                       FontSize="32"
                                       FontWeight="ExtraBold"
                                       Foreground="#A0A0A0"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <!-- Freio -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="14"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="FREIO"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="ApexFreioValor"
                                       Text="—"
                                       FontSize="32"
                                       FontWeight="ExtraBold"
                                       Foreground="#A0A0A0"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <!-- Ápice -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="14"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="ÁPICE"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="ApexApiceValor"
                                       Text="—"
                                       FontSize="32"
                                       FontWeight="ExtraBold"
                                       Foreground="#A0A0A0"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <!-- Saída -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="14"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="SAÍDA"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="ApexSaidaValor"
                                       Text="—"
                                       FontSize="32"
                                       FontWeight="ExtraBold"
                                       Foreground="#A0A0A0"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </Grid>

                    <!--
                        Info bloco — delta gigante no centro + ação abaixo.
                        Mockup: position:absolute left/top 50% translate(-50%, -50%).
                        Em XAML: StackPanel centralizado com VerticalAlignment Center.
                    -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14">
                        <TextBlock x:Name="DeltaText"
                                   Text="0.00"
                                   FontSize="180"
                                   FontWeight="ExtraBold"
                                   Foreground="#A0A0A0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AcaoText"
                                   Text=""
                                   FontSize="32"
                                   FontWeight="ExtraBold"
                                   Foreground="#F0C040"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Status text (debug, no rodapé) -->
                    <TextBlock x:Name="StatusText"
                               Text="—"
                               Foreground="#606060"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,8"/>

                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</Window>
