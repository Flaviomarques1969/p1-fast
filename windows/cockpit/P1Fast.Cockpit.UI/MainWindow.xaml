<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="P1Fast.Cockpit.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="P1 Fast — Cockpit Piloto">

    <!--
        LAYOUT APROVADO (Flávio 22/06) — porta fiel do web/cockpit/cockpit-volta-real.html.
        Device canônico 956×440. Cada LED é uma célula com um HALO (Ellipse maior, atrás)
        que transborda pros vizinhos = efeito "wash" premium do shift light / luz de freio.
          • Delta gigante à ESQUERDA · Resultado da freada à DIREITA (separados).
          • Luzes de FREIO verticais nas DUAS laterais.
          • Shift light (marcha) embaixo, 17 LEDs em pirâmide.
          • Cluster de 14 sensores no TOPO · barra de voltas no topo.
          • Ápice (Entrada/Freio/Ápice/Saída) na base.
    -->
    <Grid Background="#0a0a0a">
        <Viewbox HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 StretchDirection="Both">

            <Border Width="956" Height="440"
                    Background="#000000"
                    CornerRadius="48"
                    BorderThickness="1"
                    BorderBrush="#1F1F1F">
                <Grid>

                    <Rectangle x:Name="HaloRect" IsHitTestVisible="False" Opacity="1.0">
                        <Rectangle.Fill>
                            <RadialGradientBrush x:Name="HaloBrush"
                                                 Center="0.5,0.55"
                                                 GradientOrigin="0.5,0.55"
                                                 RadiusX="0.65"
                                                 RadiusY="0.75">
                                <GradientStop x:Name="HaloStopCenter" Offset="0.0" Color="Transparent"/>
                                <GradientStop x:Name="HaloStopEdge"   Offset="0.65" Color="Transparent"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0"
                            Width="36" Height="128"
                            CornerRadius="20"
                            Background="Black"
                            BorderBrush="#0E0E0E"
                            BorderThickness="1"/>

                    <!-- ───────── LUZ DE FREIO ESQUERDA (vertical) ───────── -->
                    <StackPanel HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0"
                                Spacing="11">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="-32"/>
                        </StackPanel.RenderTransform>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeLGlow1" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeL1" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeLGlow2" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeL2" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeLGlow3" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeL3" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeLGlow4" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeL4" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeLGlow5" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeL5" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeLGlow6" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeL6" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeLGlow7" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeL7" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeLGlow8" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeL8" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeLGlow9" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeL9" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                    </StackPanel>

                    <!-- ───────── LUZ DE FREIO DIREITA ───────── -->
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                Spacing="11">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="-32"/>
                        </StackPanel.RenderTransform>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeRGlow1" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeR1" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeRGlow2" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeR2" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeRGlow3" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeR3" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeRGlow4" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeR4" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeRGlow5" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeR5" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeRGlow6" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeR6" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeRGlow7" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeR7" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeRGlow8" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeR8" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <Grid Width="14" Height="14"><Ellipse x:Name="BrakeRGlow9" Width="46" Height="46" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="BrakeR9" Width="14" Height="14" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                    </StackPanel>

                    <!-- ───────── CLUSTER DE SENSORES (topo) ───────── -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,6,0,0"
                            Padding="22,5"
                            CornerRadius="15"
                            Background="#14181E"
                            BorderBrush="#2A2F37"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="40" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="MOTOR" FontSize="9" FontWeight="Bold" Foreground="#8A8A8A" CharacterSpacing="120" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <Ellipse x:Name="SensorRpm"        Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorAcel"       Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorFreioPedal" Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorAgua"       Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorLambda"     Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorBateria"    Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorAlarme"     Width="22" Height="22" Fill="#8A3A34"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="MOVIMENTO" FontSize="9" FontWeight="Bold" Foreground="#8A8A8A" CharacterSpacing="120" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <Ellipse x:Name="SensorGps"   Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorAccel" Width="22" Height="22" Fill="#8A3A34"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="CHASSI" FontSize="9" FontWeight="Bold" Foreground="#8A8A8A" CharacterSpacing="120" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <Ellipse x:Name="SensorPneus"    Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorSusp"     Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorCambio"   Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorFreioDed" Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorDirecao"  Width="22" Height="22" Fill="#8A3A34"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ───────── BARRA DE VOLTAS / STINT ───────── -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,50,0,0"
                                Spacing="3">
                        <Border x:Name="StintBlock01" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock02" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock03" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock04" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock05" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock06" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock07" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock08" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock09" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock10" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock11" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock12" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                    </StackPanel>

                    <!-- ───────── DELTA à ESQUERDA ───────── -->
                    <StackPanel x:Name="DeltaPanel"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="430"
                                Margin="72,0,0,0"
                                Spacing="6">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="-30"/>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="DeltaText"
                                   Text="0.00"
                                   FontSize="116"
                                   FontWeight="ExtraBold"
                                   Foreground="#A0A0A0"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="AcaoText"
                                   Text=""
                                   FontSize="26"
                                   FontWeight="ExtraBold"
                                   Foreground="#F0C040"
                                   TextWrapping="NoWrap"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- ───────── RESULTADO DA FREADA à DIREITA ───────── -->
                    <StackPanel x:Name="BrakeResultPanel"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="220"
                                Margin="0,0,72,0"
                                Spacing="4">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="-30"/>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="BrakeResultNum"
                                   Text="—"
                                   FontSize="92"
                                   FontWeight="ExtraBold"
                                   Foreground="#8C8C8C"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="BrakeResultWord"
                                   Text="FREADA"
                                   FontSize="28"
                                   FontWeight="ExtraBold"
                                   CharacterSpacing="120"
                                   Foreground="#8C8C8C"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border x:Name="AlertBlocoRoot"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,40,0"
                            MaxWidth="360"
                            RenderTransformOrigin="0.5,0.5"
                            Visibility="Collapsed">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="AlertScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Border.RenderTransform>
                        <TextBlock x:Name="AlertText"
                                   Text=""
                                   FontSize="32"
                                   FontWeight="ExtraBold"
                                   Foreground="#82C8FF"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- ───────── ÁPICE na base ───────── -->
                    <Grid Margin="60,0,36,62"
                          VerticalAlignment="Bottom"
                          Height="62">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Left" Spacing="4">
                            <TextBlock x:Name="ApexEntradaValor" Text="—" FontSize="28" FontWeight="ExtraBold" Foreground="#606060" HorizontalAlignment="Left"/>
                            <TextBlock Text="ENTRADA" FontSize="13" FontWeight="Bold" Foreground="White" CharacterSpacing="250" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="ApexFreioValor" Text="—" FontSize="28" FontWeight="ExtraBold" Foreground="#606060" HorizontalAlignment="Center"/>
                            <TextBlock Text="FREIO" FontSize="13" FontWeight="Bold" Foreground="White" CharacterSpacing="250" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="ApexApiceValor" Text="—" FontSize="28" FontWeight="ExtraBold" Foreground="#606060" HorizontalAlignment="Center"/>
                            <TextBlock Text="ÁPICE" FontSize="13" FontWeight="Bold" Foreground="White" CharacterSpacing="250" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" Spacing="4">
                            <TextBlock x:Name="ApexSaidaValor" Text="—" FontSize="28" FontWeight="ExtraBold" Foreground="#606060" HorizontalAlignment="Right"/>
                            <TextBlock Text="SAÍDA" FontSize="13" FontWeight="Bold" Foreground="White" CharacterSpacing="250" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- ───────── SHIFT LIGHT (marcha) embaixo — 17 LEDs com halo (wash) ───────── -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,10"
                            Padding="26,9"
                            CornerRadius="999"
                            Background="#080808"
                            BorderBrush="#1A1A1A"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow01" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led01" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow02" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led02" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow03" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led03" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow04" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led04" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow05" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led05" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow06" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led06" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow07" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led07" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow08" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led08" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow09" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led09" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow10" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led10" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow11" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led11" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow12" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led12" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow13" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led13" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow14" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led14" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow15" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led15" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow16" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led16" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <Grid Width="13" Height="13"><Ellipse x:Name="LedGlow17" Width="40" Height="40" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse x:Name="Led17" Width="13" Height="13" Fill="#161616" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusText"
                               Text="—"
                               Foreground="#383838"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,46"/>

                    <!-- WASH do corte de giro: luz vermelha que transborda do shift light
                         (base) pra cima e "lava" o painel quando atinge o máximo. -->
                    <Rectangle x:Name="ShiftWashRect" IsHitTestVisible="False" Opacity="0">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,1.06" GradientOrigin="0.5,1.06" RadiusX="0.9" RadiusY="1.0">
                                <GradientStop Offset="0.0"  Color="#D8FF3A30"/>
                                <GradientStop Offset="0.45" Color="#66FF3A30"/>
                                <GradientStop Offset="1.0"  Color="#00FF3A30"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</Window>
