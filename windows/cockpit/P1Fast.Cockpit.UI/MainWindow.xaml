<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="P1Fast.Cockpit.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="P1 Fast — Cockpit Piloto">

    <!--
        LAYOUT APROVADO (Flávio 22/06) — porta fiel do web/cockpit/cockpit-volta-real.html.
        Device canônico 956×440. Cada LED é uma célula com um HALO (Ellipse maior, atrás)
        que transborda pros vizinhos = efeito "wash" premium do shift light / luz de freio.
          • Delta gigante à ESQUERDA · Resultado da freada à DIREITA (separados).
          • Luzes de FREIO verticais nas DUAS laterais.
          • Shift light (marcha) embaixo, 17 LEDs em pirâmide.
          • Cluster de 14 sensores no TOPO · barra de voltas no topo.
          • Ápice (Entrada/Freio/Ápice/Saída) na base.
    -->
    <Grid x:Name="RootGrid" Background="#0a0a0a" SizeChanged="OnRootSizeChanged">
        <!-- O device (956×440) é centralizado e escalado pelo code-behind
             (OnRootSizeChanged) pelo MENOR fator min(w/956, h/440): cabe INTEIRO em
             qualquer tela, com tarja preta (letterbox) na sobra, e a barra de marcha
             embaixo SEMPRE aparece. (O Viewbox nativo preenchia por altura e cortava.) -->
            <Border Width="956" Height="440"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#000000"
                    CornerRadius="48"
                    BorderThickness="1"
                    BorderBrush="#1F1F1F">
                <Border.RenderTransform>
                    <!-- Ancorado no canto (0,0): escala a partir do topo-esquerda e DEPOIS
                         translada pra centralizar (calculado no code-behind). Determinístico,
                         sem depender de RenderTransformOrigin/CenterX (que não pegaram). -->
                    <TransformGroup>
                        <ScaleTransform x:Name="DeviceScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="DeviceTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Grid>

                    <Rectangle x:Name="HaloRect" IsHitTestVisible="False" Opacity="1.0">
                        <Rectangle.Fill>
                            <RadialGradientBrush x:Name="HaloBrush"
                                                 Center="0.5,0.55"
                                                 GradientOrigin="0.5,0.55"
                                                 RadiusX="0.65"
                                                 RadiusY="0.75">
                                <GradientStop x:Name="HaloStopCenter" Offset="0.0" Color="Transparent"/>
                                <GradientStop x:Name="HaloStopEdge"   Offset="0.65" Color="Transparent"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0"
                            Width="36" Height="128"
                            CornerRadius="20"
                            Background="Black"
                            BorderBrush="#0E0E0E"
                            BorderThickness="1"/>

                    <!-- ───────── LUZ DE FREIO ESQUERDA (vertical) ───────── -->
                    <StackPanel HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0"
                                Spacing="11">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="-32"/>
                        </StackPanel.RenderTransform>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeLGlow1" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeL1" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeLGlow2" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeL2" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeLGlow3" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeL3" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeLGlow4" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeL4" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeLGlow5" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeL5" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeLGlow6" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeL6" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeLGlow7" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeL7" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeLGlow8" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeL8" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeLGlow9" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeL9" Width="14" Height="14" Fill="#161616"/></Canvas>
                    </StackPanel>

                    <!-- ───────── LUZ DE FREIO DIREITA ───────── -->
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                Spacing="11">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="-32"/>
                        </StackPanel.RenderTransform>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeRGlow1" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeR1" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeRGlow2" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeR2" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeRGlow3" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeR3" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeRGlow4" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeR4" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeRGlow5" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeR5" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeRGlow6" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeR6" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeRGlow7" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeR7" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeRGlow8" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeR8" Width="14" Height="14" Fill="#161616"/></Canvas>
                        <Canvas Width="14" Height="14"><Ellipse x:Name="BrakeRGlow9" Width="46" Height="46" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="BrakeR9" Width="14" Height="14" Fill="#161616"/></Canvas>
                    </StackPanel>

                    <!-- ───────── CLUSTER DE SENSORES (topo) ───────── -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,6,0,0"
                            Padding="22,5"
                            CornerRadius="15"
                            Background="#14181E"
                            BorderBrush="#2A2F37"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="40" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="MOTOR" FontSize="9" FontWeight="Bold" Foreground="#8A8A8A" CharacterSpacing="120" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <Ellipse x:Name="SensorRpm"        Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorAcel"       Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorFreioPedal" Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorAgua"       Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorLambda"     Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorBateria"    Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorAlarme"     Width="22" Height="22" Fill="#8A3A34"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="MOVIMENTO" FontSize="9" FontWeight="Bold" Foreground="#8A8A8A" CharacterSpacing="120" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <Ellipse x:Name="SensorGps"   Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorAccel" Width="22" Height="22" Fill="#8A3A34"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="CHASSI" FontSize="9" FontWeight="Bold" Foreground="#8A8A8A" CharacterSpacing="120" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <Ellipse x:Name="SensorPneus"    Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorSusp"     Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorCambio"   Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorFreioDed" Width="22" Height="22" Fill="#8A3A34"/>
                                    <Ellipse x:Name="SensorDirecao"  Width="22" Height="22" Fill="#8A3A34"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ───────── BARRA DE VOLTAS / STINT ───────── -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,50,0,0"
                                Spacing="3">
                        <Border x:Name="StintBlock01" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock02" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock03" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock04" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock05" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock06" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock07" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock08" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock09" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock10" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock11" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                        <Border x:Name="StintBlock12" Width="65" Height="14" CornerRadius="2" Background="#606060"/>
                    </StackPanel>

                    <!-- ───────── DELTA à ESQUERDA ───────── -->
                    <StackPanel x:Name="DeltaPanel"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="430"
                                Margin="72,0,0,0"
                                Spacing="6">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="-30"/>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="DeltaText"
                                   Text="0.00"
                                   FontSize="116"
                                   FontWeight="ExtraBold"
                                   Foreground="#A0A0A0"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="AcaoText"
                                   Text=""
                                   FontSize="26"
                                   FontWeight="ExtraBold"
                                   Foreground="#F0C040"
                                   TextWrapping="NoWrap"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- ───────── RESULTADO DA FREADA à DIREITA ───────── -->
                    <StackPanel x:Name="BrakeResultPanel"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="220"
                                Margin="0,0,72,0"
                                Spacing="4">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="-30"/>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="BrakeResultNum"
                                   Text="—"
                                   FontSize="92"
                                   FontWeight="ExtraBold"
                                   Foreground="#8C8C8C"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="BrakeResultWord"
                                   Text="FREADA"
                                   FontSize="28"
                                   FontWeight="ExtraBold"
                                   CharacterSpacing="120"
                                   Foreground="#8C8C8C"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border x:Name="AlertBlocoRoot"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,40,0"
                            MaxWidth="360"
                            RenderTransformOrigin="0.5,0.5"
                            Visibility="Collapsed">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="AlertScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Border.RenderTransform>
                        <TextBlock x:Name="AlertText"
                                   Text=""
                                   FontSize="32"
                                   FontWeight="ExtraBold"
                                   Foreground="#82C8FF"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- ───────── ÁPICE na base ───────── -->
                    <Grid Margin="60,0,36,62"
                          VerticalAlignment="Bottom"
                          Height="62">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Left" Spacing="4">
                            <TextBlock x:Name="ApexEntradaValor" Text="—" FontSize="28" FontWeight="ExtraBold" Foreground="#606060" HorizontalAlignment="Left"/>
                            <TextBlock Text="ENTRADA" FontSize="13" FontWeight="Bold" Foreground="White" CharacterSpacing="250" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="ApexFreioValor" Text="—" FontSize="28" FontWeight="ExtraBold" Foreground="#606060" HorizontalAlignment="Center"/>
                            <TextBlock Text="FREIO" FontSize="13" FontWeight="Bold" Foreground="White" CharacterSpacing="250" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="ApexApiceValor" Text="—" FontSize="28" FontWeight="ExtraBold" Foreground="#606060" HorizontalAlignment="Center"/>
                            <TextBlock Text="ÁPICE" FontSize="13" FontWeight="Bold" Foreground="White" CharacterSpacing="250" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" Spacing="4">
                            <TextBlock x:Name="ApexSaidaValor" Text="—" FontSize="28" FontWeight="ExtraBold" Foreground="#606060" HorizontalAlignment="Right"/>
                            <TextBlock Text="SAÍDA" FontSize="13" FontWeight="Bold" Foreground="White" CharacterSpacing="250" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- ───────── SHIFT LIGHT (marcha) embaixo — 17 LEDs com halo (wash) ───────── -->
                    <Grid HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,10">
                        <!-- Camada 2 do WASH DA TROCA: moldura do shift ganha brilho AZUL
                             em volta. Dois anéis (largo+suave / estreito+forte) que piscam
                             junto com o wash. Margin negativa = transbordam a pílula. -->
                        <Rectangle x:Name="ShiftPillGlow2" Margin="-10" RadiusX="999" RadiusY="999"
                                   Stroke="#5599CCFF" StrokeThickness="9" Opacity="0" IsHitTestVisible="False"/>
                        <Rectangle x:Name="ShiftPillGlow"  Margin="-4"  RadiusX="999" RadiusY="999"
                                   Stroke="#AAB8DCFF" StrokeThickness="4" Opacity="0" IsHitTestVisible="False"/>
                        <!-- Pílula de fundo como Rectangle: NÃO recorta os halos. Antes era
                             um Border CornerRadius=999, que recortava o wash e deixava o
                             brilho QUADRADO ao piscar (Flávio 25/06). -->
                        <Rectangle RadiusX="999" RadiusY="999"
                                   Fill="#080808" Stroke="#1A1A1A" StrokeThickness="1"/>
                        <!-- Células em CANVAS (não Grid de tamanho fixo): o Canvas NÃO recorta
                             o halo, então o brilho transborda redondo. Com Grid 13×13 o halo
                             de 60px era recortado num QUADRADO (Flávio 25/06). O halo é
                             posicionado/centralizado no code-behind (InitGlow). -->
                        <StackPanel Orientation="Horizontal" Spacing="18" Margin="26,9">
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow01" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led01" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow02" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led02" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow03" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led03" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow04" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led04" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow05" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led05" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow06" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led06" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow07" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led07" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow08" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led08" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow09" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led09" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow10" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led10" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow11" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led11" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow12" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led12" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow13" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led13" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow14" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led14" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow15" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led15" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow16" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led16" Width="13" Height="13" Fill="#161616"/></Canvas>
                            <Canvas Width="13" Height="13"><Ellipse x:Name="LedGlow17" Width="40" Height="40" Opacity="0" IsHitTestVisible="False"/><Ellipse x:Name="Led17" Width="13" Height="13" Fill="#161616"/></Canvas>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="StatusText"
                               Text="—"
                               Foreground="#383838"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,46"/>

                    <!-- WASH DA TROCA (evento FIRE / "troca agora"): clarão BRANCO-AZULADO
                         na tela inteira, mais forte no TOPO e espalhando pra baixo, com brilho
                         na borda. Cor de propósito diferente do verde/amarelo/vermelho da
                         subida e do vermelho do overrev — o cérebro lê "EVENTO: troque agora".
                         Spec ditada pelo Flávio 25/06 (BRIEFING-NOTEBOOK-WASH-DA-TROCA.md):
                         0,30s, 3 pulsos a 10 Hz, uma vez por troca. -->
                    <Rectangle x:Name="ShiftWashRect" IsHitTestVisible="False" Opacity="0">
                        <Rectangle.Fill>
                            <!-- Mais forte EMBAIXO (de onde nasce a luz de marcha), espalhando
                                 pra cima — Flávio 25/06. Núcleo quase branco e opaco pra
                                 intensidade máxima na percepção periférica. -->
                            <RadialGradientBrush Center="0.5,1.10" GradientOrigin="0.5,1.10" RadiusX="1.25" RadiusY="1.45">
                                <GradientStop Offset="0.0"  Color="#FFF3F5FF"/>
                                <GradientStop Offset="0.30" Color="#F0DCE8FF"/>
                                <GradientStop Offset="0.62" Color="#9078A0FF"/>
                                <GradientStop Offset="1.0"  Color="#12305EFF"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- LAVADO DA FREADA (hora de frear): VERMELHO, distinto do branco-azul
                         da troca pra não confundir. Ponto mais forte EMBAIXO, espalhando
                         pra cima. Dispara ao chegar no ponto de freada. -->
                    <Rectangle x:Name="BrakeWashRect" IsHitTestVisible="False" Opacity="0">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,1.10" GradientOrigin="0.5,1.10" RadiusX="1.25" RadiusY="1.45">
                                <GradientStop Offset="0.0"  Color="#FFFF3A2A"/>
                                <GradientStop Offset="0.30" Color="#EAF02A1E"/>
                                <GradientStop Offset="0.62" Color="#80B01410"/>
                                <GradientStop Offset="1.0"  Color="#14400806"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                </Grid>
            </Border>
    </Grid>
</Window>
