<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8">
<title>TV do box — quadro de curvas</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
:root{ --fundo:#060709; --painel:#0c0e12; --linha:#1b1f27; --linha2:#262b35; --texto:#e9ecf1; --apagado:#7b818c; --fraco:#4a505b;
  --verde:#2fd27a; --vermelho:#ff4d4d; --ambar:#f0b429; }
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:var(--fundo);color:var(--texto);overflow:hidden;font-family:-apple-system,"Segoe UI",Helvetica,Arial,sans-serif}
#palco{position:absolute;left:0;top:0;width:1920px;height:1080px;transform-origin:0 0}
#tv{position:absolute;left:0;top:0;width:1920px;height:1080px;border:0}
.num{font-variant-numeric:tabular-nums}
.rot{font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--apagado);font-weight:600}
.cx{position:absolute;background:var(--painel);border:1px solid var(--linha);border-radius:14px}
#tabCx{left:684px;top:92px;width:1222px;height:700px}
#grafCx{left:684px;top:804px;width:1222px;height:262px}
#faixaVolta{position:absolute;left:22px;right:22px;top:16px;height:64px;display:flex;align-items:center;gap:34px}
#faixaVolta .v{font-size:30px;font-weight:600}
#faixaVolta .gr{font-size:46px;font-weight:300}
table{position:absolute;left:14px;right:14px;top:92px;border-collapse:collapse;width:calc(100% - 28px)}
th{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--apagado);font-weight:600;text-align:right;padding:8px 10px;border-bottom:1px solid var(--linha2);line-height:1.3}
th:first-child,td:first-child{text-align:left}
td{padding:0 10px;height:62px;border-bottom:1px solid var(--linha);text-align:right;vertical-align:middle}
td .val{font-size:22px;font-weight:600}
td .dl{display:block;font-size:15px;font-weight:700;margin-top:2px}
td .nm{font-size:16px;font-weight:700;letter-spacing:.06em}
td .sub{display:block;font-size:11px;color:var(--apagado);letter-spacing:.08em;margin-top:3px}
tr.agora td{background:#141821}
tr.agora td:first-child{box-shadow:inset 4px 0 0 var(--ambar)}
.vd{color:var(--verde)} .vm{color:var(--vermelho)} .am{color:var(--ambar)} .ap{color:var(--apagado)} .fr{color:var(--fraco)}
canvas{position:absolute;left:0;top:0}
#nota{position:absolute;left:24px;bottom:4px;font-size:11px;color:var(--apagado);max-width:640px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#ctrl{position:absolute;left:24px;top:1046px;display:flex;gap:6px}
#ctrl button{width:64px;height:28px;border-radius:8px;border:1px solid var(--linha2);background:var(--painel);color:var(--apagado);font:600 12px -apple-system,sans-serif;cursor:pointer}
#ctrl button.on{background:#1a1f28;color:var(--texto);border-color:#3a4150}
#selo{position:absolute;left:250px;top:1050px;font-size:12px;font-weight:700;letter-spacing:.12em;color:var(--ambar)}
</style></head><body>
<div id="palco">
  <iframe id="tv" src="/_design-reference/mockup-command-box-vista-piloto.html?canal=cockpit-bubi-replay-mac"></iframe>
  <div class="cx" id="tabCx" style="background:none;border:0"></div>
  <div class="cx" id="grafCx">
    <span class="rot" style="position:absolute;left:22px;top:14px">Voltas sobrepostas · velocidade × posição na pista</span>
    <span id="grafLeg" style="position:absolute;right:22px;top:12px;font-size:12px;color:var(--apagado)"></span>
    <canvas id="graf" width="1222" height="262"></canvas>
  </div>
  <div id="ctrl"><button data-vel="1">1×</button><button data-vel="4" class="on">4×</button><button data-vel="10">10×</button></div>
  <div id="selo">GRAVAÇÃO · NÃO É AO VIVO</div>
</div>
<script type="module">
// Comparativo de DELTA por trecho da metodologia (8 trechos de BARRAS-BRASILIA-FLAVIO-APROVADO, mesmos do carro).
// Por trecho e por volta: entrada (km/h na linha de entrada), frenagem (m do início da freada até o ponto da vmin),
// vmin (km/h) e onde ela ficou em relação ao ápice (m ao longo do traçado: − antes, + depois), passagem no ápice
// (menor distância em m entre o carro e o ponto do ápice), saída (km/h na linha de saída) e tempo do trecho.
// Referência = melhor volta completa. Mapa, vídeo e cabeçalho são os da TV oficial (iframe por baixo).
const { criarQuadroCurvas } = await import('/_tocar/quadro-curvas.js');
const quadroCurvas = criarQuadroCurvas(document.getElementById('tabCx'));
const { TRECHOS_BRASILIA } = await import('/web/command-box/trechos-brasilia.js');
const { TIPO_POR_CURVA, semFreadaPorTipo } = await import('/web/command-box/tipos-curva-brasilia.js');
const LINHA_CHEGADA = { a:{lat:-15.7728816,lng:-47.9000707}, b:{lat:-15.7725493,lng:-47.9001926} };
const $ = id => document.getElementById(id);
const fmt = (n, c=0) => n == null || !isFinite(n) ? '—' : n.toLocaleString('pt-BR',{minimumFractionDigits:c,maximumFractionDigits:c}).replace('-', '−');
const sn = (n, c=0) => { if (n == null || !isFinite(n)) return ''; const a = fmt(Math.abs(n), c); return (/^[0,]+$/.test(a) ? '±' : n > 0 ? '+' : '−') + a; };
const tempo = s => s == null ? '—' : Math.floor(s/60) + ':' + (s%60).toFixed(1).padStart(4,'0').replace('.',',');

function escala(){ const k = Math.min(innerWidth/1920, innerHeight/1080), p = $('palco');
  p.style.transform = `scale(${k})`; p.style.left = ((innerWidth-1920*k)/2)+'px'; p.style.top = ((innerHeight-1080*k)/2)+'px'; }
addEventListener('resize', escala); escala();

// ---------- geometria local (metros, origem na linha de chegada) ----------
const LAT0 = LINHA_CHEGADA.a.lat, LNG0 = LINHA_CHEGADA.a.lng, KX = Math.cos(LAT0*Math.PI/180)*111320, KY = 110540;
const pr = g => ({ x:(g.lng-LNG0)*KX, y:(g.lat-LAT0)*KY });
function linha(l, ext=15){ const A = pr(l.a), B = pr(l.b), L = Math.hypot(B.x-A.x, B.y-A.y) || 1, ex = (B.x-A.x)/L*ext, ey = (B.y-A.y)/L*ext;
  return [{x:A.x-ex,y:A.y-ey},{x:B.x+ex,y:B.y+ey}]; }
function cruza(p1,p2,[p3,p4]){ const d=(a,b,c)=>(c.x-a.x)*(b.y-a.y)-(c.y-a.y)*(b.x-a.x);
  return d(p3,p4,p1)*d(p3,p4,p2) < 0 && d(p1,p2,p3)*d(p1,p2,p4) < 0; }
const CHEGADA = linha(LINHA_CHEGADA, 20);
// regra da metodologia: curva SF (pé embaixo, ex.: VITÓRIA) é RETA, não é trecho (tipos-curva-brasilia.js)
const TR = TRECHOS_BRASILIA.filter(t => !semFreadaPorTipo(TIPO_POR_CURVA[t.nome])).map(t => ({ id:t.id, nome:t.nome, ent:linha(t.entrada_line_gps), sai:linha(t.saida_line_gps), ap:pr(t.apice_gps) }));

// ---------- estado ----------
let E;
function novo(){ return { ult:null, tUlt:null, gl:0, volta:null, voltas:[], melhor:null, freios:[], brk:false, aberto:{}, ordem:[], v:0 }; }
function feed(p){
  const t = p.tWall/1000, P = pr(p), dt = E.tUlt == null ? 0.04 : Math.max(0.001, Math.min(0.5, t-E.tUlt)); E.tUlt = t;
  E.gl += (1-Math.exp(-dt/0.15))*(p.gLong - E.gl); E.v = p.kmh; E.P = P;
  const passo = E.ult && p.fix >= 3 && p.kmh >= 3 ? Math.min(30, Math.hypot(P.x-E.ult.x, P.y-E.ult.y)) : 0;
  // volta
  if (E.ult && cruza(E.ult, P, CHEGADA)) {
    if (E.volta && t - E.volta.t0 > 50) { const v = E.volta; v.tempo = t - v.t0; v.L = v.d; E.voltas.push(v);
      if (!E.melhor || v.tempo < E.melhor.tempo) E.melhor = v; }
    if (!E.volta || t - E.volta.t0 > 50) { E.volta = { n:E.voltas.length+1, t0:t, d:0, serie:[[0,0,p.kmh]], tr:{} }; E.aberto = {}; E.freios = []; }
  }
  if (E.volta) { E.volta.d += passo; const s = E.volta.serie; if (E.volta.d - s[s.length-1][0] >= 4) s.push([E.volta.d, t-E.volta.t0, p.kmh]); }
  const d = E.volta ? E.volta.d : null;
  // início de freada (G longitudinal medido, < −0,18 g)
  if (!E.brk && E.gl < -0.18 && p.kmh > 15) { E.brk = true; if (d != null) E.freios.push(d); }
  if (E.brk && E.gl > -0.06) E.brk = false;
  // trechos
  if (E.ult && E.volta) for (const T of TR) {
    if (cruza(E.ult, P, T.ent)) E.aberto[T.id] = { t0:t, d0:d, kE:p.kmh, vmin:p.kmh, dVmin:d, apD:Math.hypot(P.x-T.ap.x, P.y-T.ap.y), dAp:d };
    const a = E.aberto[T.id];
    if (a) {
      if (p.kmh < a.vmin) { a.vmin = p.kmh; a.dVmin = d; }
      const dap = Math.hypot(P.x-T.ap.x, P.y-T.ap.y); if (dap < a.apD) { a.apD = dap; a.dAp = d; }
      if (cruza(E.ult, P, T.sai)) {
        const fr = E.freios.filter(f => f >= a.d0 - 200 && f <= a.dVmin).pop();
        E.volta.tr[T.id] = { kE:a.kE, freio: fr != null ? a.dVmin - fr : null, vmin:a.vmin, vminAp: a.dVmin - a.dAp, apD:a.apD, kS:p.kmh, tempo:t-a.t0, d0:a.d0, d1:d, dAp:a.dAp, n:E.volta.n };
        if (!E.ordem.includes(T.id)) E.ordem.push(T.id);
        delete E.aberto[T.id];
      } else if (d - a.d0 > 1500) delete E.aberto[T.id];   // entrou e não saiu (box): descarta
    }
  }
  E.ult = P;
}
function tMelhorEm(dd){ const s = E.melhor.serie; if (dd > s[s.length-1][0]) return null; let lo=0, hi=s.length-1;
  while (hi-lo>1){ const m=(lo+hi)>>1; if (s[m][0] < dd) lo=m; else hi=m; } const [d0,t0]=s[lo],[d1,t1]=s[hi]; return t0+(t1-t0)*((dd-d0)/((d1-d0)||1)); }

// ---------- quadro de curvas: MELHOR (referência) e ÚLTIMA passagem em cada curva ----------
const CAMPOS = ['kE','freio','vmin','vminAp','apD','kS','tempo'];
function pintaTabela(){
  // ordem da VOLTA: pela posição do trecho na referência (ou na volta atual/anterior); o que ainda não passou vai ao fim
  const pos = id => { for (const v of [E.melhor, E.voltas[E.voltas.length-1], E.volta]) if (v && v.tr[id]) return v.tr[id].d0; return 1e9; };
  const ordem = TR.map(t=>t.id).sort((a,b) => pos(a) - pos(b));
  const atual = Object.keys(E.aberto)[0];
  let soma = null;
  const curvas = ordem.map(id => {
    const T = TR.find(x => x.id === id), cur = E.volta && E.volta.tr[id], ant = E.voltas.length ? E.voltas[E.voltas.length-1].tr[id] : null;
    const u = cur || ant, ref = E.melhor ? E.melhor.tr[id] : null, ehRef = !!(u && ref && u === ref);
    if (u && ref && !ehRef) soma = (soma || 0) + (u.tempo - ref.tempo);
    let progresso = null;
    if (id === atual && E.volta) { const a = E.aberto[id], L = ref ? ref.d1 - ref.d0 : (u ? u.d1 - u.d0 : null); if (L) progresso = (E.volta.d - a.d0) / L; }
    const pick = r => r ? Object.fromEntries(CAMPOS.map(k => [k, r[k]]).concat([['n', r.n]])) : null;
    return { id, nome:T.nome, estado: id === atual ? 'agora' : u ? 'feita' : 'aguardando',
      sub: id === atual ? 'passando agora' + (u ? ' · volta ' + u.n : '') : u ? 'volta ' + u.n + (ehRef ? ' · é a referência' : '') : 'aguardando',
      progresso, ehRef, melhor: pick(ref), ultima: pick(u) }; });
  const tv = E.volta ? E.tUlt - E.volta.t0 : null, tb = E.melhor && E.volta ? tMelhorEm(E.volta.d) : null;
  quadroCurvas.atualizar({
    volta: { n: E.volta ? E.volta.n : null, tempo: tv, delta: tb == null ? null : tv - tb, kmh: E.v },
    ultimaVolta: E.voltas.length ? E.voltas[E.voltas.length-1].tempo : null, melhorVolta: E.melhor ? E.melhor.tempo : null,
    melhorNumero: E.melhor ? E.melhor.n : null,
    referencia: E.melhor ? 'melhor volta · nº ' + E.melhor.n : 'depois da 1ª volta completa',
    somaDelta: soma, curvas });
}

// ---------- gráfico horizontal: voltas sobrepostas, cursor na posição do carro ----------
function pintaGraf(){
  const c = $('graf').getContext('2d'), W = 1222, H = 262, x0 = 58, x1 = W-22, y0 = 226, y1 = 64; c.clearRect(0,0,W,H);
  const L = E.melhor ? E.melhor.L : 5384, X = dd => x0 + Math.min(1, dd/L)*(x1-x0);
  const vt = Math.max(100, Math.ceil(Math.max(0, ...E.voltas.flatMap(v => v.serie.map(s=>s[2])), E.v)/20)*20), Y = v => y0 - v/vt*(y0-y1);
  c.font = '600 11px -apple-system,"Segoe UI",Helvetica,Arial,sans-serif';
  // faixas dos trechos (pela referência; sem ela, pela volta atual)
  const base = E.melhor || E.volta;
  if (base) for (const T of TR) { const r = base.tr[T.id]; if (!r) continue; const xa = X(r.d0), xb = X(r.d1);
    c.fillStyle = 'rgba(255,255,255,.035)'; c.fillRect(xa, y1-8, xb-xa, y0-y1+8);
    c.strokeStyle = '#4a505b'; c.beginPath(); c.moveTo(X(r.dAp), y1-8); c.lineTo(X(r.dAp), y1-2); c.stroke();
    c.fillStyle = '#7b818c'; c.textAlign = 'center'; c.fillText(T.nome.replace('CURVA ','').replace('DA ','').replace('DO ',''), (xa+xb)/2, y1-14); }
  c.strokeStyle = '#1b1f27'; c.lineWidth = 1; c.fillStyle = '#4a505b'; c.textAlign = 'right';
  for (let v = 0; v <= vt; v += vt/4) { c.beginPath(); c.moveTo(x0,Y(v)); c.lineTo(x1,Y(v)); c.stroke(); c.fillText(fmt(v), x0-8, Y(v)+4); }
  c.textAlign = 'center'; for (let m = 0; m <= L; m += 500) c.fillText(m ? fmt(m/1000,1) + ' km' : 'largada', X(m), 248);
  const linhaV = (s, cor, w) => { c.strokeStyle = cor; c.lineWidth = w; c.beginPath(); s.forEach((q,i)=>{ const x = X(q[0]), y = Y(q[2]); i ? c.lineTo(x,y) : c.moveTo(x,y); }); c.stroke(); };
  E.voltas.forEach(v => { if (v !== E.melhor) linhaV(v.serie, 'rgba(123,129,140,.45)', 1.5); });
  if (E.melhor) linhaV(E.melhor.serie, '#2fd27a', 2.5);
  if (E.volta) linhaV(E.volta.serie, '#f0b429', 2.5);
  if (E.volta) { const x = X(E.volta.d); c.strokeStyle = '#e9ecf1'; c.lineWidth = 2; c.beginPath(); c.moveTo(x, y1-8); c.lineTo(x, y0); c.stroke();
    c.fillStyle = '#e9ecf1'; c.beginPath(); c.arc(x, Y(E.v), 6, 0, 7); c.fill();
    c.textAlign = x > x1-120 ? 'right' : 'left'; c.fillText(fmt(E.volta.d) + ' m · ' + fmt(E.v) + ' km/h', x + (x > x1-120 ? -10 : 10), y0 - 8); }
  $('grafLeg').innerHTML = `<span class="am">━ volta atual</span> &nbsp; <span class="vd">━ melhor</span> &nbsp; <span class="ap">━ anteriores</span> &nbsp; traço = ápice`;
}

// ---------- tocador: a mesma gravação vai para a TV oficial (mapa) e para o comparativo ----------
const tv = $('tv'); await new Promise(ok => tv.addEventListener('load', ok, { once:true }));
const w = tv.contentWindow, cb = await w.eval("import('/web/cockpit/cloud-bridge.js')");
const st = w.document.createElement('style');
st.textContent = `[data-block-id]:not([data-block-id="header"]):not([data-block-id="video"]):not([data-block-id="mapa"]){visibility:hidden!important}`;
w.document.head.appendChild(st);
let pts = [], idx = 0, rel = 0, vel = 4, ult = performance.now(), ultTxt = 0, desloc = 0, ultEnviado = 0;
async function carregar(){
  E = novo(); idx = 0; pts = await (await fetch('/_tocar/pista-2106.json')).json();
  const i = Math.max(0, pts.findIndex(p => p.kmh > 3)), ti = pts[i].tWall - 20000; pts = pts.filter(p => p.tWall >= ti); rel = pts[0].tWall/1000;
  // a TV oficial recebe o horário DA GRAVAÇÃO trazido para hoje (intervalos reais, mesmo em 4×/10×), sempre crescente entre rodadas
  desloc = Math.max(Date.now(), ultEnviado + 1000) - pts[0].tWall;
}
await carregar();
function quadro(ms){
  const dt = Math.min(0.25, (ms-ult)/1000); ult = ms; rel += dt*vel;
  while (idx < pts.length && pts[idx].tWall/1000 <= rel) { const p = pts[idx++]; feed(p); ultEnviado = p.tWall + desloc; cb.__tocarGps(Object.assign({}, p, { tWall: ultEnviado })); }
  if (idx >= pts.length) carregar();
  pintaGraf(); if (ms - ultTxt > 120) { pintaTabela(); ultTxt = ms; }
  requestAnimationFrame(quadro);
}
document.querySelectorAll('#ctrl button').forEach(b => b.onclick = () => { document.querySelectorAll('#ctrl button').forEach(x => x.classList.toggle('on', x === b)); vel = +b.dataset.vel; });
const q = new URLSearchParams(location.search); if (q.get('vel')) { const b = document.querySelector(`[data-vel="${q.get('vel')}"]`); if (b) b.click(); }
requestAnimationFrame(quadro);
window.__estado = () => E;
</script>
</body></html>
