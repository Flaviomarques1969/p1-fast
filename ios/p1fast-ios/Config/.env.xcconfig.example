// ═══════════════════════════════════════════════════════════
// .env.xcconfig.example — copie pra .env.xcconfig (gitignored)
// ═══════════════════════════════════════════════════════════
// Como usar:
//   cp Config/.env.xcconfig.example Config/.env.xcconfig
//   # edite Config/.env.xcconfig com as credenciais reais
//
// Notas:
// - URLs precisam escapar `//` como `https:/$()/host` — xcconfig trata `//`
//   como comentário. Sem o `$()` o que vier depois das duas barras é cortado.
// - Nunca commite Config/.env.xcconfig — está em .gitignore.
// - Projeto Supabase do P1 Fast é ISOLADO do CDAI Imunoterapia. Use credenciais
//   exclusivas — não copie de outro projeto.

SUPABASE_URL = https:/$()/<seu-projeto>.supabase.co
SUPABASE_ANON_KEY = <anon-key-do-projeto-p1-fast>
DAILY_API_KEY = <api-key-do-daily-co>
